# Database Configuration (Managed PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cds_database

# Backend Security & Server Settings
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:4173
PORT=8000
WEB_CONCURRENCY=2

# AI Services API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_api_token_here

# Vertex AI Configuration (Optional - set to true if using GCP Vertex AI instead of AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-key.json
GCS_VIDEO_BUCKET=your_gcs_bucket_name

# Object Storage Configuration (AWS S3 / Cloudflare R2 / MinIO / DigitalOcean Spaces)
S3_BUCKET=your_s3_bucket_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://your-s3-endpoint-url.com
